---
const response = await fetch("http://localhost:3000/users");
const users = await response.json();
---

<section class="p-6 bg-gray-100">
  <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Usuarios</h2>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {users.map((user) => (
      <div key={user.id} class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition duration-300">
        <h3 class="text-xl font-semibold text-gray-700">{user.name}</h3>
        <p class="text-gray-500">{user.email}</p>
        <p class="text-sm text-gray-400 mt-2">Registrado el {new Date(user.created_at).toLocaleDateString()}</p>
      </div>
    ))}
  </div>
</section>