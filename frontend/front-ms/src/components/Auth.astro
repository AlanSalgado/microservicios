<section class="p-6 bg-gray-100">
    <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Autenticación</h2>

    <form action="">
        <label class="block mb-2 text-gray-700">Correo:</label>
        <input type="email" name="email" class="border p-2 w-full mb-4 rounded" required />

        <label class="block mb-2 text-gray-700">Contraseña:</label>
        <input type="password" name="password" class="border p-2 w-full mb-4 rounded" required />

        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 w-full">
            Iniciar Sesión
        </button>
    </form>
</section>